# ─────────────────────────────────────────────────────────────
# Firebase Admin SDK
# Obtén estas credenciales desde:
# Firebase Console → Project settings → Service accounts → Generate new private key
# ─────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# IMPORTANTE: envuelve la clave en comillas dobles y mantén los \n literales
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────
# CORS (solo aplica en desarrollo cuando no usas el proxy de Vite)
# ─────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
